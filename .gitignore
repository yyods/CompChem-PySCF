# Python
.venv/
__pycache__/
*.pyc

# PyInstaller freeze output (see the "Freeze the client" section in the README)
build/
dist/
*.spec

# Calculation outputs. Everything here is generated — reproduce it by running
# the scripts or the service, don't commit it. The environment record that makes
# the numbers reproducible is the Dockerfile and docker-compose.yml, not the
# outputs themselves.
results/

# Scratch and batch artefacts — never committed
jobs/
resources/

# OS cruft
.DS_Store
Thumbs.db
