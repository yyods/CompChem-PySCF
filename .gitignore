# Python
.venv/
__pycache__/
*.pyc

# Calculation outputs. The small structured record IS the deliverable and is
# committed; anything else under results/ is scratch.
# Note results/* not results/ — git cannot re-include a file whose parent
# directory is excluded.
results/*
!results/*.txt
!results/*.xyz
!results/*.json

# Scratch and batch artefacts — never committed
jobs/
resources/

# OS cruft
.DS_Store
Thumbs.db
